<mujoco model="campus_perimeter_patrol">
  <!-- ======================================================================
       MDRIIA Group 05 | Collaborative Dual-UAV Surveillance
       DEFAULT SCENE: INSIDE the NMIMS Main Building, Vile Parle (West), Mumbai
         - central atrium (measured from the satellite skylight) with gallery
           corridors on all ten floors
         - ground floor: corridor ring, cafeteria, VIP Lounge (restricted zone),
           Board Room, lift lobby, Wall of Fame, entry foyer
       Alpha patrols the ground-floor corridor loop; Bravo sweeps the atrium.
       Exterior perimeter variant: campus_perimeter_patrol_exterior.xml
       Owner: E043 Muaaz Mohammed Iqbal Shaikh

       Course scaffold names are preserved (uav_alpha/bravo, cam_alpha/bravo,
       alpha_m0..3, alpha_accel/gyro, human_intruder, substation_zone), so
       src/test_env.py runs unmodified. Fixes vs. the scaffold model are
       documented in uav_fleet.xml and docs/planning/ (PRD section 7).
       ====================================================================== -->
  <compiler angle="radian" autolimits="true"/>
  <option gravity="0 0 -9.81" timestep="0.002" integrator="implicitfast"
          density="1.204" viscosity="1.8e-5" wind="0 0 0"/>
  <statistic center="0 -18 12" extent="60" meansize="0.3"/>
  <visual>
    <headlight diffuse="0.42 0.42 0.42" ambient="0.42 0.41 0.40" specular="0 0 0"/>
    <global azimuth="200" elevation="-35" offwidth="1600" offheight="900"/>
    <!-- fractions of extent (60 m): near clip 2.4 cm -->
    <map znear="0.0004" zfar="6"/>
    <quality shadowsize="4096"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.80 0.86 0.92" rgb2="0.55 0.64 0.74" width="512" height="3072"/>
  </asset>

  <include file="common.xml"/>
  <include file="nmims_main_interior.xml"/>
  <include file="uav_fleet.xml"/>

  <worldbody>
    <geom name="ground" type="plane" size="120 120 0.1" rgba="0.45 0.45 0.43 1"/>
  </worldbody>
</mujoco>
