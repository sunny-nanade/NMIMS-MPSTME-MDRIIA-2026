    <!-- overcast Mumbai sky, as in the tour panorama -->
    <material name="facade_white"  rgba="0.95 0.95 0.93 1" specular="0.1"/>
    <material name="glazing"       rgba="0.50 0.54 0.58 1" specular="0.3" reflectance="0.08"/>
    <material name="roof"          rgba="0.80 0.80 0.78 1"/>
