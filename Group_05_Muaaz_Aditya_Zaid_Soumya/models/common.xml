    <material name="escalator"     rgba="0.55 0.58 0.35 1" specular="0.6"/>
  </asset>

  <default>
    <geom condim="3" friction="1.0 0.01 0.005"/>
    <!-- visual-only geometry: never collides, never perturbs the dynamics -->
    <default class="visual">
      <geom contype="0" conaffinity="0" group="1"/>
    </default>
    <default class="quad">
      <geom condim="3" solref="0.004 1"/>
      <site type="sphere" size="0.02" group="4"/>
      <!-- 7.5 N per rotor (scaffold value); 4 x 7.5 = 30 N vs 13.24 N weight
           -> thrust-to-weight 2.27. gear = (fx fy fz tx ty tz) in the rotor
           site frame: fz = 1 thrust, tz = +/-kQ rotor drag reaction torque.
           kQ = 0.0201 m (torque/thrust ratio, Skydio X2 MJCF, MuJoCo Menagerie). -->
      <default class="rotor_ccw"><motor ctrlrange="0 7.5" gear="0 0 1 0 0  0.0201"/></default>
      <default class="rotor_cw"> <motor ctrlrange="0 7.5" gear="0 0 1 0 0 -0.0201"/></default>
    </default>
  </default>
</mujoco>
