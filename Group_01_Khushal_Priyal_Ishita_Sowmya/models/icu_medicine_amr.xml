<mujoco model="icu_medicine_delivery_amr">
  <compiler angle="radian" coordinate="local"/>
  <option gravity="0 0 -9.81" timestep="0.002" solver="Newton" iterations="50"/>
  <default>
    <geom contype="1" conaffinity="1" condim="3" friction="0.8 0.005 0.0001"/>
    <joint damping="0.1"/>
  </default>
  <asset>
    <material name="chassis_mat" rgba="0.15 0.35 0.65 1.0" roughness="0.4"/>
    <material name="wheel_mat" rgba="0.1 0.1 0.1 1.0" roughness="0.9"/>
    <material name="caster_mat" rgba="0.8 0.8 0.8 1.0" roughness="0.1"/>
    <material name="payload_mat" rgba="0.2 0.8 0.3 0.9" roughness="0.2"/>
    <material name="floor_mat" rgba="0.9 0.9 0.92 1.0" roughness="0.1"/>
    <material name="wall_mat" rgba="0.75 0.8 0.85 1.0"/>
  </asset>
  <worldbody>
    <geom name="floor" type="plane" size="12 4 0.1" material="floor_mat"/>
    <light directional="true" pos="0 0 6" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="north_wall" type="box" size="12 0.05 1.2" pos="0 2.2 1.2" material="wall_mat"/>
    <geom name="south_wall" type="box" size="12 0.05 1.2" pos="0 -2.2 1.2" material="wall_mat"/>
    <geom name="crash_cart" type="box" size="0.4 0.3 0.6" pos="3.0 0.5 0.6" rgba="0.85 0.2 0.2 1"/>
    <geom name="iv_stand" type="cylinder" size="0.15 0.8" pos="6.5 -0.6 0.8" rgba="0.7 0.7 0.7 1"/>
    <body name="amr_base" pos="-5.0 0 0.12">
      <freejoint name="amr_free_joint"/>
      <geom name="chassis" type="box" size="0.32 0.22 0.10" material="chassis_mat" mass="22.0"/>
      <geom name="payload_compartment" type="box" size="0.18 0.14 0.08" pos="0 0 0.15" material="payload_mat" mass="6.0"/>
      <body name="left_wheel" pos="0 0.25 0">
        <joint name="left_wheel_joint" type="hinge" axis="0 1 0" damping="0.05"/>
        <geom name="left_wheel_geom" type="cylinder" size="0.10 0.03" quat="0.7071 0.7071 0 0" material="wheel_mat" mass="1.5"/>
      </body>
      <body name="right_wheel" pos="0 -0.25 0">
        <joint name="right_wheel_joint" type="hinge" axis="0 1 0" damping="0.05"/>
        <geom name="right_wheel_geom" type="cylinder" size="0.10 0.03" quat="0.7071 0.7071 0 0" material="wheel_mat" mass="1.5"/>
      </body>
      <body name="front_caster" pos="0.22 0 -0.06">
        <geom name="front_caster_geom" type="sphere" size="0.04" material="caster_mat" mass="0.5" friction="0.005 0.001 0.0001"/>
      </body>
      <body name="rear_caster" pos="-0.22 0 -0.06">
        <geom name="rear_caster_geom" type="sphere" size="0.04" material="caster_mat" mass="0.5" friction="0.005 0.001 0.0001"/>
      </body>
      <site name="rangefinder_center" pos="0.32 0 0.05" size="0.02" rgba="1 0 0 1"/>
      <site name="rangefinder_left" pos="0.30 0.15 0.05" quat="0.9659 0 0 0.2588" size="0.02" rgba="0 1 0 1"/>
      <site name="rangefinder_right" pos="0.30 -0.15 0.05" quat="0.9659 0 0 -0.2588" size="0.02" rgba="0 0 1 1"/>
    </body>
  </worldbody>
  <actuator>
    <velocity name="left_motor" joint="left_wheel_joint" kv="50" ctrlrange="-10 10"/>
    <velocity name="right_motor" joint="right_wheel_joint" kv="50" ctrlrange="-10 10"/>
  </actuator>
  <sensor>
    <rangefinder name="rf_center" site="rangefinder_center"/>
    <rangefinder name="rf_left" site="rangefinder_left"/>
    <rangefinder name="rf_right" site="rangefinder_right"/>
  </sensor>
</mujoco>
