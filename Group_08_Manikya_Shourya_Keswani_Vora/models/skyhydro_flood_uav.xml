<mujoco model="skyhydro_flood_relief_uav">
  <compiler angle="radian" coordinate="local"/>
  <option gravity="0 0 -9.81" timestep="0.002" integrator="RK4"/>

  <visual>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    <rgba fog="0.85 0.88 0.92 1"/>
  </visual>

  <default>
    <joint damping="0.1" armature="0.005"/>
    <geom friction="0.7 0.01 0.001" solref="0.01 1" solimp="0.9 0.95 0.001"/>
    <motor ctrlrange="-40 40" ctrllimited="true"/>
  </default>

  <worldbody>
    <!-- Flood Water Surface Simulation -->
    <geom name="flood_water" type="plane" size="25 25 0.1" rgba="0.18 0.32 0.45 0.85"/>

    <!-- Isolated Rooftop Drop Target Structure -->
    <body name="rooftop_target" pos="0 0 1.5">
      <geom name="building_block" type="box" size="2.5 2.5 1.5" pos="0 0 -1.5" rgba="0.65 0.65 0.65 1"/>
      <geom name="drop_zone_outer" type="cylinder" size="2.0 0.02" pos="0 0 0.02" rgba="0.85 0.85 0.2 1"/>
      <geom name="drop_zone_bullseye" type="cylinder" size="0.6 0.025" pos="0 0 0.025" rgba="0.85 0.2 0.2 1"/>
      <site name="target_center" pos="0 0 0.04"/>
    </body>

    <!-- Multirotor UAV Airframe -->
    <body name="uav_chassis" pos="0 0 12.0">
      <freejoint name="uav_root_joint"/>
      <!-- Central Carbon Fiber Hub -->
      <geom name="fuselage" type="cylinder" size="0.18 0.06" rgba="0.2 0.25 0.3 1" mass="2.2"/>

      <!-- 4 Quadrotor Arms -->
      <geom name="arm1" type="capsule" size="0.018 0.22" pos="0.22 0.22 0" quat="0.9239 0 0 0.3827" rgba="0.1 0.1 0.1 1" mass="0.25"/>
      <geom name="arm2" type="capsule" size="0.018 0.22" pos="-0.22 0.22 0" quat="0.3827 0 0 0.9239" rgba="0.1 0.1 0.1 1" mass="0.25"/>
      <geom name="arm3" type="capsule" size="0.018 0.22" pos="-0.22 -0.22 0" quat="0.3827 0 0 -0.9239" rgba="0.1 0.1 0.1 1" mass="0.25"/>
      <geom name="arm4" type="capsule" size="0.018 0.22" pos="0.22 -0.22 0" quat="0.9239 0 0 -0.3827" rgba="0.1 0.1 0.1 1" mass="0.25"/>

      <!-- Downward Vision Sensor Site -->
      <site name="downward_cam_site" pos="0 0 -0.06" quat="0.7071 0.7071 0 0"/>

      <!-- Winch Deployment Anchor -->
      <site name="winch_anchor" pos="0 0 -0.08"/>

      <!-- Cable Link (Suspended Slung Load) -->
      <body name="winch_cable" pos="0 0 -0.15">
        <joint name="cable_pitch" type="hinge" axis="0 1 0" range="-1.2 1.2"/>
        <joint name="cable_roll" type="hinge" axis="1 0 0" range="-1.2 1.2"/>
        <geom name="cable_geom" type="capsule" size="0.006 1.8" pos="0 0 -1.8" rgba="0.7 0.7 0.7 0.8" mass="0.15"/>

        <!-- Medical Relief Canister Payload -->
        <body name="relief_payload" pos="0 0 -3.6">
          <geom name="payload_box" type="cylinder" size="0.14 0.18" rgba="0.9 0.15 0.15 1" mass="1.5"/>
          <geom name="cross_h" type="box" size="0.09 0.025 0.02" pos="0 0.142 0" rgba="1 1 1 1" mass="0.01"/>
          <geom name="cross_v" type="box" size="0.025 0.09 0.02" pos="0 0.142 0" rgba="1 1 1 1" mass="0.01"/>
          <site name="payload_sensor" pos="0 0 0"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Quadrotor Motor Thrusts -->
    <motor name="rotor1_thrust" body="uav_chassis" gear="0 0 1 0 0 0" ctrlrange="0 35"/>
    <motor name="rotor2_thrust" body="uav_chassis" gear="0 0 1 0 0 0" ctrlrange="0 35"/>
    <motor name="rotor3_thrust" body="uav_chassis" gear="0 0 1 0 0 0" ctrlrange="0 35"/>
    <motor name="rotor4_thrust" body="uav_chassis" gear="0 0 1 0 0 0" ctrlrange="0 35"/>
  </actuator>

  <sensor>
    <accelerometer name="uav_accel" site="downward_cam_site"/>
    <gyro name="uav_gyro" site="downward_cam_site"/>
  </sensor>
</mujoco>
